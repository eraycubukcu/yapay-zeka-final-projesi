# Spotify Web API — album artwork fetching
# Get these at: https://developer.spotify.com/dashboard
#   1. Create app (name/website/redirect URI: anything, not used here)
#   2. Copy Client ID and Client Secret below
#   3. Rename this file to .env
#   4. Restart the Flask server (python app.py)
#
# If these are missing or invalid, the backend gracefully returns empty
# artwork URLs and the frontend falls back to cluster emoji icons.

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
